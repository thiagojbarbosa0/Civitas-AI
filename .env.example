# demo: funciona sem API key e sem LLM; llm: LangChain com inferência de verdade
CIVITAS_MODE=demo
CIVITAS_PROVIDER=ollama
CIVITAS_MODEL=llama3.2
# CIVITAS_API_KEY= (preencha apenas em ambiente seguro; nunca commite)
# CIVITAS_BASE_URL=http://localhost:11434/v1
# CIVITAS_ADMIN_TOKEN=defina-um-token-forte
CIVITAS_EMBEDDINGS=bm25
# Para usar embeddings reais, instale requirements-embeddings.txt e selecione hybrid
# CIVITAS_EMBEDDINGS=hybrid
# CIVITAS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Para Docker com LangChain: CIVITAS_DOCKER_WITH_LLM=true
